# Ambiente da API (development | production | test)
NODE_ENV=development
# Porta HTTP da API
PORT=3100
# Conexão com o Postgres do docker compose (porta 5433 no host, para não brigar com outro Postgres local)
DATABASE_URL=postgres://cdc:cdc@localhost:5433/cdc
# Onde o Ollama está rodando (no macOS, o Ollama nativo)
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de embeddings (precisa gerar vetores de EMBEDDING_DIMENSIONS posições)
OLLAMA_EMBED_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# Modelo de chat. Com 16 GB de RAM ou mais, qwen2.5:7b responde melhor
OLLAMA_CHAT_MODEL=qwen2.5:3b
# ollama | anthropic (anthropic usa Claude só para gerar a resposta)
LLM_PROVIDER=ollama
# Só necessário com LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Similaridade mínima para responder (calibrada com pnpm eval)
MIN_SIMILARITY=0.5
# Tempo máximo de geração da resposta, em milissegundos
LLM_TIMEOUT_MS=90000
# Pasta com os textos das leis (relativa a apps/api)
LAWS_DIR=../../data/laws
# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
