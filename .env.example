# Ambiente da API (development | production | test)
NODE_ENV=development
# Porta HTTP da API
PORT=3100
# Conexão com o Postgres do docker compose (porta 5433 no host, para não brigar com outro Postgres local)
DATABASE_URL=postgres://cdc:cdc@localhost:5433/cdc
# Provedores: openai (padrão) | ollama para embeddings; openai | anthropic | ollama para a resposta
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai
# Chave da OpenAI (https://platform.openai.com/api-keys). Nunca versione este valor.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-6-luna
# Onde o Ollama está rodando, se você usar o provedor ollama (no macOS, o Ollama nativo)
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de embeddings do Ollama
OLLAMA_EMBED_MODEL=bge-m3
# Tamanho dos vetores (a coluna chunks.embedding é vector(1024))
EMBEDDING_DIMENSIONS=1024
# Modelo de chat do Ollama (precisa de uns 16 GB de RAM)
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Só necessário com LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Similaridade mínima para responder (calibrada com pnpm eval)
MIN_SIMILARITY=0.5
# Tempo máximo de geração da resposta, em milissegundos
LLM_TIMEOUT_MS=90000
# Pasta com os textos das leis (relativa a apps/api)
LAWS_DIR=../../data/laws
# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
