{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS do pergunte-ao-cdc: ingestão, busca híbrida e chat com SSE.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts",
    "fetch-laws": "tsx scripts/fetch-laws.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "eval": "tsx src/eval/run-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@cdc/contracts": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "nestjs-pino": "^5.3.1",
    "openai": "^7.28.0",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
