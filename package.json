{
  "name": "pergunte-ao-cdc",
  "version": "0.0.0",
  "private": true,
  "description": "Assistente que responde perguntas sobre direito do consumidor citando os artigos de lei (RAG com pgvector e Ollama).",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contracts": "pnpm --filter @cdc/contracts build",
    "dev": "pnpm build:contracts && pnpm --parallel --filter @cdc/contracts --filter api --filter web dev",
    "build": "pnpm build:contracts && pnpm -r --filter '!@cdc/contracts' build",
    "typecheck": "pnpm build:contracts && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build:contracts && pnpm -r test",
    "test:int": "pnpm build:contracts && pnpm --filter api test:int",
    "db:migrate": "pnpm --filter api db:migrate",
    "ingest": "pnpm build:contracts && pnpm --filter api ingest",
    "eval": "pnpm build:contracts && pnpm --filter api eval",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,json}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.9.3"
  }
}
